---
import { IconRepeat, IconTarget, IconUsers } from '@tabler/icons-react'

const FEATURES = [
  {
    icon: IconUsers,
    title: 'Visão compartilhada das despesas',
    desc: 'Vocês dois veem tudo no mesmo lugar, em tempo real.',
  },
  {
    icon: IconRepeat,
    title: 'Transações recorrentes automáticas',
    desc: 'Aluguel, assinaturas e contas que se repetem sozinhas.',
  },
  {
    icon: IconTarget,
    title: 'Controle de metas juntos',
    desc: 'Planejem e acompanhem objetivos a dois.',
  },
]
---

<section class="px-4 py-10 sm:px-6 sm:py-14">
  <div class="mx-auto grid max-w-5xl grid-cols-1 gap-6 md:grid-cols-3">
    {
      FEATURES.map(({ icon: Icon, title, desc }) => (
        <div class="flex flex-col items-start gap-3 rounded-2xl border border-neutral-100 bg-neutral-50 p-5">
          <span class="flex h-11 w-11 items-center justify-center rounded-full bg-brand-100 text-brand-700">
            <Icon size={22} stroke={1.75} />
          </span>
          <div>
            <p class="font-semibold text-neutral-900">{title}</p>
            <p class="mt-1 text-sm text-neutral-600">{desc}</p>
          </div>
        </div>
      ))
    }
  </div>
</section>

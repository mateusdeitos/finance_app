# Copie este arquivo para terraform.tfvars e preencha com valores reais.
# terraform.tfvars é gitignored — nunca commitar.
#
# Autenticação do provider Cloudflare NÃO fica aqui: exporte
#   export CLOUDFLARE_API_TOKEN="..."
# antes de rodar `terraform apply` (o provider lê a env var automaticamente).
#
# Escopos exigidos no token (Custom Token no dashboard da Cloudflare):
#   Account → Cloudflare Pages → Edit   (projeto Pages e domínio customizado)
#   Zone    → DNS            → Edit     (o CNAME; Zone Resources = dividim.app)
# O token usado pela CI só precisa do primeiro — vale manter um token separado
# para o Terraform em vez de somar DNS:Edit ao que vive nos secrets do GitHub.

cloudflare_account_id = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" # mesma conta de landing/terraform
pages_project_name    = "financeapp-frontend"                # vira financeapp-frontend.pages.dev
production_branch     = "main"

# Deixe vazio no primeiro apply para validar o app na URL *.pages.dev antes de
# apontar o domínio. Depois preencha os dois e reaplique — o CNAME do domínio
# customizado é criado por este root.
custom_domain      = "app.dividim.app"
cloudflare_zone_id = "a8ab2dcacc91e328dfc7c1f1b9a305ab"
